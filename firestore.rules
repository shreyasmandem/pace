rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'shreyas0381@gmail.com';
    }

    // Private user sync data (progress, notes, bookmarks, planner)
    match /users/{userId} {
      allow read, write, delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // Community Leaderboard (public read so everyone sees everyone; write restricted to authenticated owner or admin)
    match /leaderboard/{userId} {
      allow read: if true;
      allow write, delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // System broadcast announcements & configuration
    match /system/{docId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
  }
}
