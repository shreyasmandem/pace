rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private user sync data (progress, notes, bookmarks, planner)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Community Leaderboard (public read so everyone sees everyone; write restricted to authenticated owner)
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
